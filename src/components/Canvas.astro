---

const { className } = Astro.props;
---

<div class="fluid-layer" aria-hidden="true">
  <canvas class=`fluid-canvas ${className}` data-classname={className}></canvas>
</div>

<script>
  import { mountFluid } from "../libs/fluid";
  
  const canvases = document.querySelectorAll<HTMLCanvasElement>("canvas[data-classname]:not([data-mounted])");

    canvases.forEach((canvas) => {
      canvas.dataset.mounted = "true";
      mountFluid(canvas);
    });
    
</script>

<style>
  .fluid-layer {
    /* position: fixed;
    inset: 0; */

    .fluid-1 {
      margin-left: auto;
    }
  }

  .fluid-canvas {
    display: block;
    width: 300px;
    height: 300px;
    opacity: 0.95;
    margin-bottom: 20px;
    background-color: aqua;
  }
</style>
